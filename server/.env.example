# Copy to .env and fill in. Load it with systemd's EnvironmentFile= or `node --env-file=.env server.js` (Node >= 20.6).
PORT=3000
HOST=127.0.0.1
SESSION_SECRET=change-me-to-a-long-random-string

# Same values as $dbhost/$dbuser/$dbpass in php/base.php
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=braincatalogue
# Database holding the Users table ($dblogin in php/base.php); defaults to DB_NAME
#LOGIN_DB=

# Optional
#DATA_DIR=/var/www/html/braincatalogue/data
#SENDMAIL=/usr/sbin/sendmail
#SITE_URL=https://braincatalogue.org   # used for absolute links in the RSS feed
